{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@mesa/shared": ["../shared/src/index.ts"],
      "@mesa/common": ["./src/index.ts"]
    },
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
