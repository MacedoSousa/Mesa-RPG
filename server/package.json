{
  "name": "mesa-rpg-server",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "Servidor Host do Mesa RPG: API REST, WebSockets autoritativos e PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/database/cli.ts up",
    "migrate:down": "tsx src/database/cli.ts down",
    "seed": "tsx src/database/cli.ts seed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@mesa/shared": "*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "umzug": "^3.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3"
  }
}
