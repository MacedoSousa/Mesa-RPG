# Copie para .env e ajuste os valores
NODE_ENV=development
PORT=3333

# Origens liberadas para CORS / Socket.io (separadas por vírgula).
# Use * em rede local para aceitar celulares dos jogadores.
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mesa_rpg
DATABASE_SSL=false

# Autenticação
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
