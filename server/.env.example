# Copie para server/.env e ajuste os valores.
NODE_ENV=development
PORT=3333

# Origens extras para CORS (separadas por vírgula). Em produção o próprio servidor
# entrega os clientes, então CORS só importa no modo dev (Vite em outra porta).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# PostgreSQL (docker compose up -d cria estes dois bancos)
DATABASE_URL=postgres://mesa:mesa@localhost:5432/mesa_rpg
TEST_DATABASE_URL=postgres://mesa:mesa@localhost:5432/mesa_rpg_test
DATABASE_SSL=false
DATABASE_LOGGING=false

# Autenticação (troque por valores longos e aleatórios!)
JWT_SECRET=troque-este-segredo-de-acesso-por-algo-bem-longo
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-por-outro-valor
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Código para cadastrar novas contas de Mestre (o PRIMEIRO cadastro já vira Mestre).
MASTER_INVITE_CODE=olimpo-2026

# Salvamento automático do estado da mesa (segundos)
AUTOSAVE_SECONDS=60
AUTOSAVE_KEEP=5
